# Application name
APP_NAME="Backend Multi-Agent"

# PostgreSQL database connection
# Format: postgresql://user:password@host:port/db_name
DATABASE_URL="postgresql+psycopg2://user:password@db:5432/agents_db"

# LLM configuration (Local with LM Studio)
LLM_BASE_URL="http://host.docker.internal:1234/v1"
