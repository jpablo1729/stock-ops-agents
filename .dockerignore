# Virtual environment (should be rebuilt inside the container)
.venv

# Python cache files and compiled bytecode
__pycache__
*.pyc
*.pyo
*.pyd
.Python

# Git repository and config (not needed inside the image)
.git
.gitignore

# Environment variables (secrets should not be baked into the image)
.env

# Local database files (containers should use a proper database service)
*.db

# Test cache
.pytest_cache

# Test
tests